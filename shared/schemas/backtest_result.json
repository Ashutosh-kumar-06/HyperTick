{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BacktestResult",
  "type": "object",
  "required": ["task_id", "status"],
  "properties": {
    "task_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["success", "compile_error", "runtime_error", "timeout", "segfault"] },
    "metrics": {
      "type": "object",
      "properties": {
        "sharpe_ratio": { "type": "number" },
        "max_drawdown_pct": { "type": "number" },
        "total_return_pct": { "type": "number" },
        "ticks_processed": { "type": "integer" },
        "avg_latency_us": { "type": "number" },
        "p99_latency_us": { "type": "number" },
        "elapsed_ms": { "type": "number" }
      }
    },
    "stderr": { "type": "string" },
    "stdout": { "type": "string" },
    "exit_code": { "type": "integer" }
  }
}
