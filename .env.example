OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# LLM provider: openai | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# For Gemini use: LLM_MODEL=gemini-2.0-flash

RABBITMQ_URL=amqp://swarm:swarm_secret@localhost:5672/
REDIS_URL=redis://localhost:6379/0
MONGODB_URL=mongodb://localhost:27017/trading_swarm

# CRDT distributed state (enable for multi-node orchestrators)
ENABLE_CRDT_SYNC=false
CRDT_NODE_ID=orchestrator-1

# KPI thresholds (REQ-1.4)
MAX_DRAWDOWN_PCT=15.0
MAX_LATENCY_US=50.0
MIN_SHARPE_RATIO=1.0

# Worker sandbox limits (REQ-5.2)
WORKER_CPU=0.5
WORKER_MEMORY=512m
WORKER_TIMEOUT_SEC=5

# Horizontal scaling
CONSUMER_REPLICAS=5
CONSUMER_INSTANCE_ID=consumer-1
RABBITMQ_PREFETCH=1
